// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Cambios sugeridos:
// 1) Eliminar `Tecnico`; mover campos a `Usuario` (opcionales / nulos)
// 2) Relaciones Muchos a Muchos implícitas: Usuario↔Especialidad, Categoria↔Especialidad, Categoria↔Etiqueta
// 3) ImagenTicket sólo se relaciona con HistorialTicket (sin FK a Ticket)
// 4) Notificacion mantiene ticketId como opcional (puede eliminarse si se desea)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------- MODELOS ----------------

// -- MODELO DE USUARIO -- 
model Usuario {
  id              Int       @id @default(autoincrement())
  nombreUsuario   String    @unique
  nombreCompleto  String
  telefono        String?
  correo          String    @unique
  contrasenaHash  String
  rol             Rol       @default(CLIENTE)
  foto            String?   @default("image-not-found.jpg")
  ultimoIngresoAt DateTime?
  activo          Boolean   @default(true)

  // Campos movidos desde "Tecnico" (opcionales // nulos)
  estadoTecnico EstadoTecnico?
  cargaTrabajo  Int?           @default(0)

  creadoAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  // Relaciones 

  // Especialidades del usuario (si actúa como técnico)
  especialidades Especialidad[] // M2M implícita Usuario↔Especialidad

  // Tickets creados/cerrados por el usuario
  tickets         Ticket[] @relation("TicketsSolicitante") // 1-M (solicitante)
  ticketsCerrados Ticket[] @relation("TicketsCerradosPor") // 1-M (cerrador)

  // Tickets asignados a este usuario (si es técnico)
  ticketsAsignados Ticket[] @relation("TicketsAsignadosAUsuario") // 1-M (asignación de tiquetes al usuario-técnico)

  // Historial de cambios hechos por el usuario en el tiquete
  historiales HistorialTicket[] @relation("HistorialCambiadoPor") // 1-M (cambiadoPor)

  // Notificaciones enviadas/recibidas por el usuario
  notifsEnviadas  Notificacion[] @relation("NotifsEnviadas") // 1-M (emisor)
  notifsRecibidas Notificacion[] @relation("NotifsRecibidas") // 1-M (receptor)

  // Valoraciones hechas por el usuario
  valoraciones ValoracionServicio[] // 1-M (valoraciones hechas)

  asignaciones Asignacion[]
}

// -- MODELO DE ESPECIALIDAD -- 
model Especialidad {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  // Relaciones
  tecnicos   Usuario[] // M2M implícita (con PK compuesta) Usuarios con rol TECNICO y esta especialidad
  categorias Categoria[] // M2M implícita (con PK compuesta) Categorías asociadas a esta especialidad
  reglas      Regla[] // 1-M
}

// -- MODELO SLA -- 
model SLA {
  id                   Int     @id @default(autoincrement())
  nombre               String  @unique
  maxMinutosRespuesta  Int
  maxMinutosResolucion Int
  activo               Boolean @default(true)

  // Relaciones
  categorias Categoria[] // 1-M
}

// -- MODELO CATEGORIA -- 
model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  slaId       Int

  creadoAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  // Relaciones
  sla            SLA            @relation(fields: [slaId], references: [id]) // M-1
  etiquetas      Etiqueta[] // M2M implícita (con PK compuesta)
  especialidades Especialidad[] // M2M implícita (con PK compuesta)
  tickets        Ticket[] // 1-M
  reglas         Regla[] // 1-M
}

// -- MODELO DE ETIQUETA --
model Etiqueta {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  // Relaciones
  categorias Categoria[] // M2M implícita (con PK compuesta)
}

// -- MODELO DE TICKET --
model Ticket {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique @db.VarChar(32) // p.ej. "INC-2025-0001"
  titulo      String
  descripcion String
  estado      EstadoTicket @default(PENDIENTE)
  prioridad   Prioridad    @default(MEDIA)

  solicitanteId     Int
  categoriaId       Int
  usuarioAsignadoId Int?

  // Deadlines basados en SLA de la categoría (persistidos para auditoría)
  fechaLimiteRespuesta  DateTime
  fechaLimiteResolucion DateTime

  // Timestamps de acciones clave
  respondidoAt      DateTime?
  resueltoAt        DateTime?
  cerradoAt         DateTime?
  cerradoPorId      Int?
  cumplioRespuesta  Boolean?
  cumplioResolucion Boolean?

  creadoAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  solicitante     Usuario   @relation("TicketsSolicitante", fields: [solicitanteId], references: [id])
  cerradoPor      Usuario?  @relation("TicketsCerradosPor", fields: [cerradoPorId], references: [id])
  categoria       Categoria @relation(fields: [categoriaId], references: [id])
  usuarioAsignado Usuario?  @relation("TicketsAsignadosAUsuario", fields: [usuarioAsignadoId], references: [id])

  // Relaciones

  // LAS IMÁGENES SE RELACIONAN CON HistorialTicket, NO DIRECTO CON Ticket
  historiales    HistorialTicket[] // 1-M
  asignaciones   Asignacion[] // 1-M
  notificaciones Notificacion[] // 1-M
  valoracion     ValoracionServicio? // 1-1

  @@index([estado]) // para búsquedas frecuentes por estado
  @@index([categoriaId]) // para búsquedas frecuentes por categoría
  @@index([usuarioAsignadoId]) // para búsquedas frecuentes por usuario (técnico) asignado
  @@index([fechaLimiteResolucion]) // para búsquedas frecuentes por fecha límite de resolución
}

// -- MODELO DE HISTORIAL DEL TICKET --
model HistorialTicket {
  id            Int           @id @default(autoincrement())
  ticketId      Int
  cambiadoPorId Int?
  deEstado      EstadoTicket?
  aEstado       EstadoTicket
  nota          String?

  creadoAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  // Relaciones
  ticket      Ticket         @relation(fields: [ticketId], references: [id]) // M-1
  cambiadoPor Usuario?        @relation("HistorialCambiadoPor", fields: [cambiadoPorId], references: [id]) // M-1
  imagenes    ImagenTicket[] // 1-M

  @@index([ticketId]) // para búsquedas frecuentes por ticket
  @@index([cambiadoPorId]) // para búsquedas frecuentes por cambiado por
}

// -- MODELO DE IMAGEN DEL TICKET -- (sin FK directa a Ticket)
model ImagenTicket {
  id          Int     @id @default(autoincrement())
  historialId Int
  url         String
  descripcion String?

  creadoAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  historial HistorialTicket @relation(fields: [historialId], references: [id])

  @@index([historialId])
}

// -- MODELO DE REGLAS DE AUTO-ASIGNACIÓN DEL TICKET --
model Regla {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  activa      Boolean   @default(true)

  // Filtros para aplicar la regla 
  categoriaId Int // Hardware, Software, Red, etc.
  prioridad   Prioridad? // Baja, Media, Alta, Urgente
  especialidadId Int // Especialidad del técnico 
  aplicaATodasPrioridades Boolean @default(false) // En caso de que la regla aplique a todas las prioridades
  
  // Peso o límite de carga (cant Tiquetes del técnico) 
  pesoCargaTrabajo Int? // null = Sin restricción

  // Orden de prioridad de regla 
  ordenPrioridad Int @default(1) // 1, 2, 3, ...

  creadoAt  DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(0)

  // Relaciones
  categoria    Categoria?    @relation(fields: [categoriaId], references: [id]) 
  especialidad Especialidad? @relation(fields: [especialidadId], references: [id])
  asignaciones Asignacion[] // 1-M

  @@index([activa]) // para búsquedas frecuentes por activa
}

// -- MODELO DE ASIGNACIÓN DEL TICKET A LOS TÉCNICOS) --
model Asignacion {
  ticketId         Int
  usuarioTecnicoId Int
  metodo           MetodoAsignacion
  motivo           String?         @db.Text
  puntajePrioridad Int?
  slaRestanteMin   Int?
  reglaId          Int?
  creadoAt         DateTime         @default(now()) @db.DateTime(0)
  updatedAt        DateTime         @default(now()) @updatedAt @db.DateTime(0)

  // Relaciones
  ticket  Ticket  @relation(fields: [ticketId], references: [id])
  usuario Usuario @relation(fields: [usuarioTecnicoId], references: [id])
  regla   Regla?  @relation(fields: [reglaId], references: [id]) // M-1

  @@id([ticketId, usuarioTecnicoId]) // PK compuesta
  @@index([reglaId]) // para búsquedas frecuentes por regla
}

// -- MODELO DE NOTIFICACIÓN --
model Notificacion {
  id         Int                @id @default(autoincrement())
  tipo       TipoNotificacion
  emisorId   Int?
  receptorId Int
  ticketId   Int?
  estado     EstadoNotificacion @default(NO_LEIDA)
  mensaje    String?
  creadoAt   DateTime           @default(now()) @db.DateTime(0)
  leidoAt    DateTime?          @db.DateTime(0)
  atendidoAt DateTime?          @db.DateTime(0)
  updatedAt  DateTime           @default(now()) @updatedAt @db.DateTime(0)

  // Relaciones
  emisor   Usuario? @relation("NotifsEnviadas", fields: [emisorId], references: [id]) // M-1 
  receptor Usuario  @relation("NotifsRecibidas", fields: [receptorId], references: [id]) // M-1
  ticket   Ticket?  @relation(fields: [ticketId], references: [id]) // M-1 opcional

  @@index([receptorId]) // para búsquedas frecuentes por receptor
  @@index([ticketId]) // para búsquedas frecuentes por ticket
  @@index([tipo]) // para búsquedas frecuentes por tipo
}

// -- MODELO DE VALORACIÓN DEL SERVICIO --
model ValoracionServicio {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @unique
  puntaje     Int // 1..5 (validar en lógica/migración SQL)
  comentario  String?
  creadoPorId Int
  creadoAt    DateTime @default(now()) @db.DateTime(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.DateTime(0)

  // Relaciones
  ticket    Ticket  @relation(fields: [ticketId], references: [id]) // 1-1
  creadoPor Usuario @relation(fields: [creadoPorId], references: [id]) // M-1
}

// -------------------------
// ENUMS
// -------------------------
enum Rol {
  ADMIN
  TECNICO
  CLIENTE
}

enum EstadoTicket {
  PENDIENTE
  ASIGNADO
  EN_PROCESO
  RESUELTO
  CERRADO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum MetodoAsignacion {
  AUTOMATICA
  MANUAL
}

enum TipoNotificacion {
  TICKET_ASIGNADO
  ESTADO_CAMBIADO
  NUEVA_OBSERVACION
  INICIO_SESION
}

enum EstadoNotificacion {
  LEIDA
  NO_LEIDA
}

enum EstadoTecnico {
  DISPONIBLE
  NO_DISPONIBLE
  DESCONECTADO
}
